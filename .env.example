# ════════════════════════════════════════════════════════════════════════
# MAS Enterprise — Environment Configuration Template
# Copy to .env and populate before running.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════

# ── Service ───────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json | console

# ── On-Prem GPU / Gemini ─────────────────────────────────────────────────
GEMINI_MODEL_ID=gemini-2.5-pro
GEMINI_API_KEY=                        # leave blank if using on-prem endpoint
GEMINI_ON_PREM_ENDPOINT=               # e.g., https://nim.internal:8000/v1

# ── AWS ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_PROFILES_TABLE=mas-user-profiles
DYNAMODB_TRANSACTIONS_TABLE=mas-transactions
DYNAMODB_ENDPOINT_URL=                 # leave blank for real AWS; set for local DynamoDB
ANALYST_USE_BEDROCK=false              # true to enable Bedrock narrative enrichment
BEDROCK_ANALYST_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_KMS_KEY_PREFIX=alias/mas-enterprise

# ── Azure ─────────────────────────────────────────────────────────────────
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=DoNotReply@notifications.mas-enterprise.com

# ── GCP ───────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
DIALOGFLOW_LOCATION=us-central1
DIALOGFLOW_AGENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=       # path to service account JSON

# ── On-Prem Identity (Keycloak — replaces Microsoft Entra ID) ────────────
KEYCLOAK_JWKS_URI=http://keycloak.internal:8080/realms/mas/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://keycloak.internal:8080/realms/mas/protocol/openid-connect/token
KEYCLOAK_INTROSPECT_URL=http://keycloak.internal:8080/realms/mas/protocol/openid-connect/token/introspect
JWT_AUDIENCE=mas-enterprise
JWT_ISSUER=https://keycloak.internal/realms/mas
MAS_CLIENT_ID=mas-service-account
MAS_CLIENT_SECRET=
REQUIRE_MTLS=false                    # true to require X-Client-Cert at ingress

# ── KMS & Secrets ─────────────────────────────────────────────────────────
KMS_BACKEND=aws                        # aws | vault
VAULT_ADDR=https://vault.internal:8200
VAULT_TOKEN=                           # use AppRole auth in production

# ── Observability (Observe) ────────────────────────────────────────────────
OBSERVE_CUSTOMER_ID=
OBSERVE_INGEST_TOKEN=
OBSERVE_DATASTREAM=mas-enterprise
OBSERVE_BASE_URL=https://collect.observeinc.com

# ── Redis (rate limiting) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PER_MINUTE=100

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://dashboard.mas-enterprise.com

# ── Salesforce ────────────────────────────────────────────────────────────
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login               # login | test (sandbox)

# ── Policies ──────────────────────────────────────────────────────────────
POLICY_FILE=policies.yaml             # or ssm:///mas/policies
